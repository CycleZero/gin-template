# 配置来源与优先级（后加载的覆盖先加载的）：
#   1. 本文件：默认值，随版本库管理
#   2. 环境变量：前缀 APP_，去掉前缀后的名字即 key（APP_DB_HOST -> DB_HOST）
#
# 本文件中的 ${KEY:default} 占位符会从「合并后的配置」解析，因此嵌套配置
# 也能用环境变量覆盖，且密钥不必写进文件。例如：
#   APP_DB_HOST=10.0.0.12 APP_DB_PASSWORD=secret ./app
data:
  db:
    host: "${DB_HOST:localhost}"
    port: "${DB_PORT:3306}"
    user: "${DB_USER:root}"
    password: "${DB_PASSWORD:your_password}"
    db_name: "${DB_NAME:gin_template}"
  redis:
    host: "${REDIS_HOST:localhost}"
    port: "${REDIS_PORT:6379}"
    password: "${REDIS_PASSWORD:}"

server:
  http:
    host: "${HTTP_HOST:0.0.0.0}"
    port: "${HTTP_PORT:8000}"
    pprof:
      enable: "${PPROF_ENABLE:true}"
      host: "${PPROF_HOST:0.0.0.0}"
      port: "${PPROF_PORT:6060}"

log:
  mode: "${LOG_MODE:dev}"      # dev | prod
  level: "${LOG_LEVEL:debug}"  # debug | info | warn | error
  dir: "${LOG_DIR:./data/log}"

app:
  dev_mode: "${DEV_MODE:true}"
  enable_db_debug: "${ENABLE_DB_DEBUG:true}"

# 可观测性：OTLP/HTTP 主动推送，一个端点同时驱动 trace / metrics / logs
# （仅 exporter 默认路径不同：/v1/traces、/v1/metrics、/v1/logs）。
#
# endpoint 留空 = 全部关闭上报（默认，零开销）。指向任一 OTLP 兼容后端即可：
#   otel-collector: http://127.0.0.1:4318
#   SigNoz / Jaeger / Tempo / Grafana Alloy 等
otel:
  endpoint: "${OTEL_ENDPOINT:}"                    # 如 http://127.0.0.1:4318
  insecure: "${OTEL_INSECURE:true}"                # 明文传输；endpoint 带 http:// 时自动为 true
  service_name: "${OTEL_SERVICE_NAME:gin-template}"
  service_version: "${OTEL_SERVICE_VERSION:v0.0.0}"
  environment: "${OTEL_ENVIRONMENT:development}"
  trace_sample_rate: "${OTEL_TRACE_SAMPLE_RATE:1.0}"      # 0.0-1.0，0 视为 1.0（全量）
  metrics_interval_seconds: "${OTEL_METRICS_INTERVAL:15}" # 指标推送周期
  # metrics_endpoint: ""   # 可选：把 metrics 单独指向别的后端（为空则由 endpoint 派生）
  # logs_endpoint: ""      # 可选：把 logs 单独指向别的后端
  # headers:               # 可选：额外请求头（如 ingestion key，建议来自环境变量）
  #   x-ingestion-key: "${OTEL_INGESTION_KEY:}"
